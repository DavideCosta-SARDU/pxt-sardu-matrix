{
    "name": "sardu-matrix",
    "version": "0.2.1",
    "description": "Configurable RGB matrix support for Microsoft MakeCode and Micro:Bit",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "neopixel": "github:microsoft/pxt-neopixel#v0.7.6",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "config.ts",
        "mapping.ts",
        "font.ts",
        "colors.ts",
        "graphics.ts",
        "graphics-presets.ts",
        "text.ts",
        "matrix.ts",
        "main.ts",
        "docs/graphics.md",
        "docs/simulator.md",
        "_locales/it/sardu-matrix-strings.json",
        "_locales/it/sardu-matrix-jsdoc-strings.json"
    ],
    "testFiles": [
        "test.ts"
    ],
    "public": true,
    "extension": {
        "namespace": "sarduMatrix",
        "label": "Editor grafico SARDU Matrix",
        "url": "https://davidecosta-sardu.github.io/pxt-sardu-matrix/editor.html",
        "localUrl": "http://127.0.0.1:5173/editor.html"
    },
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj"
}
